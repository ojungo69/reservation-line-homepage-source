# Local development: copy to .dev.vars. Keep the copied file gitignored.
# Production credentials belong in your own Wrangler secrets/configuration.
ENVIRONMENT=local
SPEC_VERSION=public-source

# Cloudflare Access protects the admin API. Configure your own Access application.
ACCESS_TEAM_DOMAIN=
ACCESS_AUD=

# LINE Login, LIFF and Messaging API; these channels use separate user IDs.
LINE_CHANNEL_ID=
LINE_LIFF_ID=
LINE_CHANNEL_SECRET=
LINE_OFFICIAL_ACCOUNT_ID=
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_OPERATIONS_USER_IDS=

# Google Calendar. Enable scheduled imports only after your calendar is configured.
GOOGLE_CALENDAR_WEBHOOK_URL=
GOOGLE_IMPORT_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Write embedded newlines as \n in the quoted single-line key value.
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Turnstile credentials and expected verification context.
TURNSTILE_SECRET_KEY=
TURNSTILE_SITE_KEY=
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=

# Sample policy versions; update when replacing the sample legal pages.
RESERVATION_NOTICE_VERSION=notice-terms-2026-06
RESERVATION_CANCELLATION_POLICY_VERSION=cancel-2026-08-31
RESERVATION_PRIVACY_POLICY_VERSION=privacy-2026-06
RESERVATION_MINOR_GUARDIAN_VERSION=minor-guardian-2026-06

# Optional reminders, notification email, Web Push and error reporting.
RESERVATION_REMINDER_DISPATCH_ENABLED=false
OPERATIONS_NOTIFICATION_EMAIL=
PENDING_APPROVAL_OWNER_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
SENTRY_DSN=
