{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "exclude": [
    "duplicates"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.mjs",
        "test/**/*.test.{ts,tsx,mts,mjs}"
      ],
      "project": [
        "src/**/*.ts",
        "test/**/*.{ts,tsx,mts,mjs}",
        "scripts/**/*.{mjs,js}"
      ],
      "ignore": [],
      "ignoreDependencies": [
        "cloudflare",
        "@sentry/core"
      ]
    },
    "admin-app": {
      "entry": [
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignore": [
        "src/components/ui/**"
      ],
      "ignoreDependencies": [
        "tailwindcss"
      ]
    }
  }
}
